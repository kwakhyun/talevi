FROM node:22-alpine AS builder
WORKDIR /srv
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci --ignore-scripts
COPY apps/web apps/web
COPY packages/contracts packages/contracts
ENV NEXT_TELEMETRY_DISABLED=1 API_INTERNAL_URL=http://api:8000
RUN npm run build
FROM node:22-alpine
WORKDIR /srv
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
RUN addgroup -g 10001 app && adduser -D -u 10001 -G app app
COPY --from=builder --chown=app:app /srv/apps/web/.next/standalone ./
COPY --from=builder --chown=app:app /srv/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=app:app /srv/apps/web/public ./apps/web/public
USER app
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
